{
  "name": "edupage-extras",
  "private": true,
  "version": "1.0.9",
  "scripts": {
    "version": "node scripts-dev/sync-version.js && git add manifest.json",
    "sync-version": "node scripts-dev/sync-version.js",
    "prelint:firefox": "npm run sync-version",
    "lint:firefox": "node scripts-dev/run-firefox-web-ext.js lint",
    "prerun:firefox": "npm run sync-version",
    "run:firefox": "node scripts-dev/run-firefox-web-ext.js run",
    "prebuild:firefox": "npm run sync-version",
    "build:firefox": "node scripts-dev/build-firefox.js",
    "presign:firefox": "npm run sync-version",
    "sign:firefox": "node scripts-dev/sign-firefox.js",
    "prebuild:chrome": "npm run sync-version",
    "build:chrome": "node scripts-dev/build-chrome.js",
    "preupload:chrome": "npm run build:chrome",
    "upload:chrome": "node scripts-dev/upload-chrome.js",
    "verify:package": "npm run verify:firefox-package",
    "verify:firefox-package": "node scripts-dev/verify-firefox-package.js --browser firefox",
    "verify:chrome-package": "node scripts-dev/verify-firefox-package.js --browser chrome",
    "test": "node --test tests/*.test.js",
    "test:browser": "node --test tests-browser/*.test.js"
  },
  "devDependencies": {
    "chrome-webstore-upload-cli": "^3.5.0",
    "jquery": "^3.7.1",
    "playwright": "^1.64.1",
    "web-ext": "^10.8.0"
  }
}
